#!/bin/bash
# ==============================================================================
# Script:      fm-report
# Description: Runs a FurMark 2 GPU burn-in test and logs the hardware performance output.
# Author:      Ralf R. (ralf.rangedahl@alina.se)
# Version:     2.0.3
# Date:        2026-04-21
# ==============================================================================

source /usr/local/bin/alina-env.sh

# ==========================================
# INITIALIZATION
# ==========================================
alina_header "🔥 GPU BURN-IN & STRESS TEST (FurMark 2)"
check_mount
get_order_num

DEST="/mnt/backupserver/värdering/$ORDER_NUM"
mkdir -p "$DEST"
LOG_FILE="$DEST/${ORDER_NUM}_FM2_Report.log"

echo "==================================================" > "$LOG_FILE"
echo " FurMark 2 Test Report - Order: $ORDER_NUM" >> "$LOG_FILE"
echo " Date: $(date)" >> "$LOG_FILE"
echo "==================================================" >> "$LOG_FILE"

echo -e "\n[ GPU Information ]" >> "$LOG_FILE"
lspci | grep -E "VGA|3D" >> "$LOG_FILE"
echo "--------------------------------------------------" >> "$LOG_FILE"

echo -e "\n${GREEN}📝 Report will be saved in: $LOG_FILE${NC}"
echo -e "\n${YELLOW}🚀 Starting 10-minute Vulkan stress test...${NC}"
echo -e "Let the test finish! It will close automatically and save the result after exactly 10 minutes."
echo -e "\nPress Enter to start."
read -r

# Use Linux 'timeout' to forcefully kill the process after 10 minutes (10m) 
# to bypass FurMark's buggy internal timers.
timeout 10m /usr/local/bin/furmark2/furmark --demo furmark-vk --benchmark --max-time 600000 2>&1 | tee -a "$LOG_FILE"

echo -e "\n${CYAN}==================================================${NC}"
echo -e "${GREEN}✅ The test is complete!${NC}"
echo -e "✅ The result has been saved on the server in: $LOG_FILE"
echo -e "${CYAN}==================================================${NC}"
# EOF