#!/bin/bash
# ==============================================================================
# Script:      arrange
# Description: Automatically tiles and arranges open windows side-by-side on the desktop.
# Author:      Ralf R. (ralf.rangedahl@alina.se)
# Version:     2.0.3
# Date:        2026-04-21
# ==============================================================================

source /usr/local/bin/alina-env.sh

# ==========================================
# INITIALIZATION
# ==========================================
alina_header "🪟 ARRANGE WINDOWS"
echo -e "${YELLOW}Organizing open windows...${NC}\n"

# Get the ID of the active desktop
current_desktop=$(xdotool get_desktop)

# Get all window IDs on the active desktop
# We filter out windows that lack a name or are system components
windows=$(xdotool search --desktop "$current_desktop" --onlyvisible --name "." | while read -r id; do
    name=$(xdotool getwindowname "$id" 2>/dev/null)
    # Ignore the desktop (Xfce Desktop) and the panel
    if [[ ! "$name" =~ "xfce4-panel" ]] && [[ ! "$name" =~ "Desktop" ]]; then
        echo "$id"
    fi
done)

# Count windows
count=$(echo "$windows" | wc -w)

if [ "$count" -eq 0 ]; then
    echo -e "${RED}❌ No manageable windows found.${NC}"
    exit 1
fi

# Get screen size and subtract a bit for the panel (margin)
screen_width=$(xdotool getdisplaygeometry | awk '{print $1}')
screen_height=$(xdotool getdisplaygeometry | awk '{print $2}')
usable_height=$((screen_height - 40)) # Adjust 40 if your panel is thicker

# Place the windows
width=$((screen_width / count))
current_x=0

for win in $windows; do
    # Remove maximization if the window is maximized (otherwise it can't be moved)
    xdotool windowactivate "$win"
    wmctrl -i -r "$win" -b remove,maximized_vert,maximized_horz 2>/dev/null
    
    # Move and resize
    xdotool windowsize "$win" "$width" "$usable_height"
    xdotool windowmove "$win" "$current_x" 30 # 30px down to avoid snapping under the panel
    current_x=$((current_x + width))
done

echo -e "${GREEN}✅ Windows successfully arranged!${NC}"
# Pause briefly so the user sees the success message if run from a terminal
sleep 1
# EOF