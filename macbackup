#!/bin/bash
# ==============================================================================
# Script:      macbackup
# Description: Safely copies user data from mounted macOS drives, excluding specific system folders.
# Author:      Ralf R. (ralf.rangedahl@alina.se)
# Version:     2.0.3
# Date:        2026-04-21
# ==============================================================================

source /usr/local/bin/alina-env.sh

# ==========================================
# INITIALIZATION
# ==========================================
alina_header "🍏 MACOS DISK BACKUP UTILITY"
check_mount

# 1. Get destination (Order Number)
DEST_INPUT="$1"
if [[ -z "$DEST_INPUT" ]]; then
    get_order_num
    DEST_INPUT="$ORDER_NUM"
fi

if [[ "$DEST_INPUT" == /* ]]; then
    DEST="$DEST_INPUT"
else
    DEST="/mnt/backupserver/$DEST_INPUT"
fi

echo -e "\n${YELLOW}Creating backup folder on the server...${NC}"
mkdir -p -v "$DEST"

echo -e "\n${WHITE}Disk space at destination:${NC}"
df -h "$DEST"

# ==========================================
# 2. SELECT SOURCE
# ==========================================
echo -e "\n${CYAN}[ SELECT SOURCE DRIVE ]${NC}"
echo -e "${WHITE}Which mounted disk do you want to back up?${NC}"
echo "  1. /mnt/disk1"
echo "  2. /mnt/disk2"
echo "  3. /mnt/disk3"
echo "  4. /mnt/disk4"
echo "  5. Custom Path"
echo "  6. Abort"
echo "--------------------------------------------------"

while true; do
    read -p "Enter a number [1-6]: " choice
    case $choice in
        1) SRC_OPT="disk1"; break ;;
        2) SRC_OPT="disk2"; break ;;
        3) SRC_OPT="disk3"; break ;;
        4) SRC_OPT="disk4"; break ;;
        5) SRC_OPT="custom"; break ;;
        6) 
           echo -e "${YELLOW}Backup aborted.${NC}"
           exit 0 
           ;;
        *) 
           echo -e "${RED}Invalid option! Try again.${NC}" 
           ;;
    esac
done

if [[ "$SRC_OPT" == "custom" ]]; then
    read -r -p "Enter full path to source folder: " SOURCE_DIR
    if [[ ! -d "$SOURCE_DIR" ]]; then
        echo -e "${RED}❌ Directory not found. Aborting.${NC}"
        exit 1
    fi
else
    SOURCE_DIR="/mnt/$SRC_OPT"
    # Check if it's actually mounted to prevent backing up an empty folder
    if ! mountpoint -q "$SOURCE_DIR"; then
        echo -e "${RED}⚠️ WARNING: $SOURCE_DIR does not appear to be mounted!${NC}"
        read -r -p "Are you sure you want to back up an unmounted folder? (y/N): " conf
        if [[ "${conf,,}" != "y" ]]; then 
            echo -e "${YELLOW}Aborting.${NC}"
            exit 1
        fi
    fi
fi

# Navigate to the chosen folder so the rsync command (which uses '.') works perfectly
cd "$SOURCE_DIR" || { echo -e "${RED}❌ Failed to access $SOURCE_DIR${NC}"; exit 1; }

echo -e "\n${CYAN}[ READY TO BACKUP ]${NC}"
echo -e "From (Source): ${WHITE}$SOURCE_DIR${NC}"
echo -e "To (Server): ${WHITE}$DEST${NC}"

if [[ "$SOURCE_DIR" == "/" ]] || [[ "$SOURCE_DIR" == "/root" ]]; then
    echo -e "\n${RED}❌ WARNING: You are about to back up the LiveCD root folder!${NC}"
    echo "Aborting for safety."
    exit 1
fi

echo -e "\nPress Enter to start the backup, or Ctrl+C to abort."
read -r

# ==========================================
# 3. RSYNC COPY
# ==========================================
EXCLUDES=(
    ".Spotlight-V100" ".fseventsd" ".DocumentRevisions-V100" ".vol" ".PKInstallSandboxManager-SystemSoftware" "cores" "private/var/vm" "private/var/folders"
    ".Trashes" ".Trash" "Users/*/.Trash" "Applications" "System" "bin" "sbin" "usr" "Network"
    "Library/Caches" "Library/Logs" "Users/*/Library/Caches" "Users/*/Library/Logs" "Users/*/Library/Containers/*/Data/Library/Caches"
    "Users/*/Library/Saved Application State" "Users/*/Library/Developer/Xcode/DerivedData"
    "Users/*/Library/Caches/Google/Chrome" "Users/*/Library/Caches/com.apple.Safari" "Users/*/Library/Caches/Mozilla/Firefox"
    ".DS_Store" ".AppleDouble" ".LSOverride" "._*"
)

RSYNC_EXCLUDES=()
for e in "${EXCLUDES[@]}"; do
    RSYNC_EXCLUDES+=("--exclude=$e")
done

echo -e "\n${YELLOW}🚀 Starting file copy of macOS data (This may take some time)...${NC}\n"

# Notice the "." at the end below. Because we did `cd "$SOURCE_DIR"`, it copies exactly what it should!
rsync -avuS --progress --numeric-ids \
      --no-owner --no-group --no-perms --chmod=u=rwX \
      "${RSYNC_EXCLUDES[@]}" \
      . "$DEST"

echo -e "\n${CYAN}==================================================${NC}"
echo -e "${GREEN}✅ Copy complete and permissions adjusted.${NC}"
echo -e "✅ macOS Backup for '$DEST_INPUT' is finished."
echo -e "${CYAN}==================================================${NC}"
# EOF