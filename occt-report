#!/bin/bash
# ==============================================================================
# Script:      occt-report
# Description: Launches an OCCT stress test and automates a screenshot capture of the results.
# Author:      Ralf R. (ralf.rangedahl@alina.se)
# Version:     2.1.11
# Date:        2026-008-11
# ==============================================================================

source /usr/local/bin/alina-env.sh

# Call the standard functions
alina_header "OCCT STRESS TEST & SCREENSHOT EXPORT"
check_mount
get_order_num

# --- SCRIPT LOGIC ---
REPORT_DIR="/mnt/backupserver/__reports"
mkdir -p "$REPORT_DIR" 2>/dev/null
FILE_PATH="${REPORT_DIR}/${ORDER_NUM}_OCCT_StressTest.png"

echo -e "${YELLOW}Launching OCCT...${NC}"
# Redirects both standard output and error to null, then runs in the background
occt >/dev/null 2>&1 &

echo -e "\n${CYAN}==================================================${NC}"
echo -e "${WHITE} START YOUR STRESS TEST NOW${NC}"
echo -e "${CYAN}==================================================${NC}"
echo -e "1. Go to the OCCT window."
echo -e "2. Configure and start your test."
echo -e "3. You have exactly ${YELLOW}2 minutes${NC} before the capture."
echo -e "4. The crosshair will appear automatically when the timer ends.\n"

SECS=120
while [ $SECS -gt 0 ]; do
    printf "\rTime remaining: %02d:%02d " $((SECS/60)) $((SECS%60))
    sleep 1
    ((SECS--))
done

echo -e "\n\n${GREEN}TIME IS UP!${NC}\a"

echo -e "${CYAN}Your mouse is now a crosshair!${NC}"
echo -e "Click directly on the OCCT window to capture the results."
scrot -s -d 1 "$FILE_PATH"

if [ -f "$FILE_PATH" ]; then
    echo -e "\n${GREEN}Screenshot successfully saved to server!${NC}"
    echo -e "Saved to: $FILE_PATH"
else
    echo -e "\n${RED}Error: Screenshot was cancelled or failed.${NC}"
fi
# EOF