#!/bin/bash
# ==============================================================================
# Script:      bitlocker
# Description: Decrypts and mounts Windows BitLocker partitions using dislocker.
# Author:      Ralf R. (ralf.rangedahl@alina.se)
# Version:     2.0.4
# Date:        2026-05-25
# ==============================================================================

source /usr/local/bin/alina-env.sh

# ==========================================
# INITIALIZATION
# ==========================================
alina_header "BITLOCKER MOUNT TOOL"

# Show available partitions
echo -e "${WHITE}Available partitions:${NC}"
lsblk -o NAME,SIZE,TYPE,FSTYPE | grep -i "part"

echo -e "\n${CYAN}--------------------------------------------------${NC}"
read -r -p "Enter the partition to decrypt (e.g., sda3): " SRC_INPUT

if [[ -z "$SRC_INPUT" ]]; then
    echo -e "${RED}No partition entered. Aborting.${NC}"
    exit 1
fi

# Smart logic: Automatically add /dev/ if it is missing
if [[ "$SRC_INPUT" == /dev/* ]]; then
    SRC_PART="$SRC_INPUT"
else
    SRC_PART="/dev/$SRC_INPUT"
fi

# Check that the partition exists
if [ ! -b "$SRC_PART" ]; then
    echo -e "${RED}Error: Partition $SRC_PART does not exist!${NC}"
    exit 1
fi

echo -e "\n${WHITE}Choose a mount destination:${NC}"
echo "  1) disk1"
echo "  2) disk2"
echo "  3) disk3"
echo "  4) disk4"
echo "--------------------------------------------------"
while true; do
    read -r -p "Enter a number [1-4]: " DEST_CHOICE
    case $DEST_CHOICE in
        1) DEST_MOUNT="/mnt/disk1"; break ;;
        2) DEST_MOUNT="/mnt/disk2"; break ;;
        3) DEST_MOUNT="/mnt/disk3"; break ;;
        4) DEST_MOUNT="/mnt/disk4"; break ;;
        *) echo -e "${RED}Invalid choice. Try again.${NC}" ;;
    esac
done

echo -e "${GREEN}You selected $DEST_MOUNT${NC}"

# The hidden folder where dislocker creates its virtual file
DECRYPT_DIR="/mnt/.dislocker"

# Create the folders if they don't exist
mkdir -p "$DECRYPT_DIR"
mkdir -p "$DEST_MOUNT"

# Unmount the hidden folder if a previous test got stuck
if mountpoint -q "$DECRYPT_DIR"; then
    umount "$DECRYPT_DIR"
fi

echo -e "\n${CYAN}--------------------------------------------------${NC}"
read -r -p "Enter BitLocker Recovery Key (48 digits): " BL_KEY
echo ""

echo -e "${YELLOW}Step 1: Decrypting BitLocker volume ($SRC_PART)...${NC}"
dislocker -V "$SRC_PART" -p"$BL_KEY" -- "$DECRYPT_DIR"

# Check if decryption succeeded by looking for the file dislocker creates
if [ ! -f "$DECRYPT_DIR/dislocker-file" ]; then
    echo -e "${RED}Decryption failed. Check your recovery key.${NC}"
    exit 1
fi

echo -e "${YELLOW}Step 2: Mounting the decrypted file system...${NC}"
# Mount the virtual ntfs file to the visible folder
mount -o loop "$DECRYPT_DIR/dislocker-file" "$DEST_MOUNT"

if [ $? -eq 0 ]; then
    echo -e "\n${CYAN}==================================================${NC}"
    echo -e "${GREEN}Success! The drive is decrypted and mounted at $DEST_MOUNT${NC}"
    echo -e "You can now browse the files or run your diskbackup script."
    echo -e "${CYAN}==================================================${NC}"
else
    echo -e "${RED}Failed to mount the decrypted file system.${NC}"
    exit 1
fi
# EOF