#!/bin/bash
# ==============================================================================
# Script:      bitlocker
# Description: Decrypts and mounts BitLocker partitions using cryptsetup.
# Author:      Ralf R. (ralf.rangedahl@alina.se)
# Version:     2.2.8
# Date:        2026-09-07
# ==============================================================================

source /usr/local/bin/alina-env.sh

# ==========================================
# INITIALIZATION
# ==========================================
alina_header "BITLOCKER MOUNT TOOL"

# ==========================================
# 1. SELECT PARTITION
# ==========================================
echo -e "\n${CYAN}[ SELECT PARTITION ]${NC}"
echo -e "${WHITE}Available partitions:${NC}"
lsblk -o NAME,SIZE,TYPE,FSTYPE | grep -iE "part|bitlocker|ntfs|exfat"

echo "--------------------------------------------------"
read -p "Enter the partition to decrypt (e.g., sda3): " PARTITION

if [ ! -b "/dev/$PARTITION" ]; then
    echo -e "${RED}Error: /dev/$PARTITION is not a valid block device.${NC}"
    exit 1
fi

# ==========================================
# 2. SELECT DESTINATION
# ==========================================
echo -e "\n${CYAN}[ SELECT DESTINATION ]${NC}"
echo -e "${WHITE}Choose a mount destination:${NC}"
echo "  1. disk1"
echo "  2. disk2"
echo "  3. disk3"
echo "  4. disk4"
echo "--------------------------------------------------"

while true; do
    read -p "Enter a number [1-4]: " dest_num
    case $dest_num in
        1) MOUNT_DEST="disk1"; break ;;
        2) MOUNT_DEST="disk2"; break ;;
        3) MOUNT_DEST="disk3"; break ;;
        4) MOUNT_DEST="disk4"; break ;;
        *) echo -e "${RED}Invalid option! Try again.${NC}" ;;
    esac
done

echo -e "${GREEN}You selected /mnt/$MOUNT_DEST${NC}"

# ==========================================
# 3. FETCH RECOVERY KEY
# ==========================================
echo -e "\n${CYAN}[ FETCH RECOVERY KEY ]${NC}"

if [[ -z "$ORDER_NUM" ]]; then
    get_order_num
fi

echo -e "${WHITE}Söker efter nyckel för order: ${ORDER_NUM}${NC}"
RECOVERY_KEY=""

if [ -n "$ORDER_NUM" ]; then
    KEY_FILE="/mnt/backupserver/__bitlocker_keys/${ORDER_NUM}.txt"

    if [ -f "$KEY_FILE" ]; then
        echo -e "${YELLOW}Hittade fil: $KEY_FILE${NC}"
        
        # Tvättar filen från eventuell Windows UTF-16 formatering (\0) och radbrytningar (\r) innan vi söker
        RECOVERY_KEY=$(cat "$KEY_FILE" | tr -d '\0\r' | grep -oE '([0-9]{6}-){7}[0-9]{6}' | head -n 1)
        
        if [ -n "$RECOVERY_KEY" ]; then
            echo -e "${GREEN}Hämtade nyckel automatiskt: $RECOVERY_KEY${NC}"
        else
            echo -e "${RED}Filen existerar, men ingen giltig 48-siffrig nyckel hittades.${NC}"
        fi
    else
        echo -e "${YELLOW}Hittade ingen nyckelfil i __bitlocker_keys för denna order.${NC}"
    fi
fi

if [ -z "$RECOVERY_KEY" ]; then
    echo "--------------------------------------------------"
    read -p "Ange BitLocker-nyckel manuellt (48 siffror): " RECOVERY_KEY
    
    if ! [[ "$RECOVERY_KEY" =~ ^([0-9]{6}-){7}[0-9]{6}$ ]]; then
        echo -e "${YELLOW}Varning: Nyckeln matchar inte standardformatet (48 siffror). Försöker ändå...${NC}"
    fi
fi

# ==========================================
# 4. DECRYPT & MOUNT
# ==========================================
echo -e "\n${CYAN}[ DECRYPTING & MOUNTING ]${NC}"
echo -e "${YELLOW}Step 1: Decrypting BitLocker volume (/dev/$PARTITION)...${NC}"

MAPPER_NAME="bitlk_${PARTITION}"

if [ -e "/dev/mapper/$MAPPER_NAME" ]; then
    sudo cryptsetup close "$MAPPER_NAME" 2>/dev/null
fi

echo "$RECOVERY_KEY" | sudo cryptsetup bitlkOpen "/dev/$PARTITION" "$MAPPER_NAME" -d -

if [ $? -ne 0 ]; then
    echo -e "${RED}Decryption failed. Check your recovery key or file content.${NC}"
    exit 1
fi

echo -e "${YELLOW}Step 2: Mounting decrypted volume to /mnt/$MOUNT_DEST...${NC}"

sudo mkdir -p "/mnt/$MOUNT_DEST"
sudo mount -t ntfs-3g "/dev/mapper/$MAPPER_NAME" "/mnt/$MOUNT_DEST"

if [ $? -eq 0 ]; then
    echo -e "\n${GREEN}==================================================${NC}"
    echo -e "${GREEN}Success! BitLocker volume is mounted and ready.${NC}"
    echo -e "${GREEN}==================================================${NC}"
    sudo systemctl restart smb
else
    echo -e "\n${RED}Mount failed. The volume was decrypted but the filesystem could not be mounted.${NC}"
    sudo cryptsetup close "$MAPPER_NAME"
    exit 1
fi